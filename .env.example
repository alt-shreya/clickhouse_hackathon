# Atlys Click-a-thon 2026 - Environment Variables
# Copy this to .env and fill in your values

# ClickHouse Cloud
CLICKHOUSE_HOST=your-cluster.region.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=atlys
ANTHROPIC_API_KEY=anthropic

# These same CLICKHOUSE_* values are also passed to the ClickHouse MCP server
# (`pip install mcp-clickhouse`) that AnalyticsAgent uses -- see
# agents/analytics/mcp_client.py. No separate env vars needed; if the
# `mcp-clickhouse` binary isn't installed/reachable, AnalyticsAgent falls back
# to querying ClickHouse directly via clickhouse-connect.

# Langfuse (optional - for tracing)
# Get keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenRouter -- the shared LLM provider for all three agents (Context,
# Instrumentation, Analytics). Without this set, every agent still runs but
# falls back to rule-based/no-op logic instead of LLM reasoning -- set it for
# real schema generation, narrative insights, and context audit.
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
